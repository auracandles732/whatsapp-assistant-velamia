PORT=3000
NODE_ENV=development

# WhatsApp Business API (Meta)
WHATSAPP_TOKEN=EAA...tu_token_aqui
WHATSAPP_PHONE_ID=tu_phone_id_aqui
WHATSAPP_BUSINESS_ACCOUNT_ID=tu_business_account_id_aqui

# Firma del webhook (Meta > Configuración de la app > Clave secreta de la app)
# Sin esto, cualquiera podría enviar mensajes falsos al webhook.
META_APP_SECRET=tu_app_secret_aqui

# OpenAI API
OPENAI_API_KEY=sk-proj-...tu_key_aqui

# Webhook Verification
WEBHOOK_VERIFY_TOKEN=tu_webhook_verify_token_seguro_aqui

# Contraseña para entrar al CRM
CRM_PASSWORD=elige_una_contrasena_segura

# Supabase PostgreSQL
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_service_key_aqui
